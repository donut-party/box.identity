{:paths ["src"]
 :deps  {buddy/buddy-hashers                     {:mvn/version "1.8.158"}
         com.google.api-client/google-api-client {:mvn/version "2.2.0"}
         metosin/malli                           {:mvn/version "0.11.0"}
         nano-id/nano-id                         {:mvn/version "1.0.0"}
         org.clojure/clojure                     {:mvn/version "1.10.3"}
         party.donut/compose                     {:mvn/version "0.0.30"}
         party.donut/dbeasy.next-jdbc            {:mvn/version "0.0.11"}
         party.donut/email                       {:mvn/version "0.0.11"}
         party.donut/endpoint                    {:mvn/version "0.0.34"}
         party.donut/frontend                    {:mvn/version "0.0.152"}
         party.donut/hooked                      {:mvn/version "0.0.12"}
         party.donut/protocol-implementation     {:mvn/version "1.0.13"}
         party.donut/sugar                       {:mvn/version "0.0.19"}
         party.donut/system                      {:mvn/version "0.0.214"}}

 :aliases
 {:dev
  {:extra-paths ["dev" "test" "resources"]}

  :test
  {:extra-paths ["test" "resources"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.0" :git/sha "48c3c67"}}
   :exec-fn     cognitect.test-runner.api/test}

  :framework-dev
  {:override-deps {party.donut/compose                 {:local/root "../compose"}
                   party.donut/email                   {:local/root "../email"}
                   party.donut/endpoint                {:local/root "../endpoint"}
                   party.donut/frontend                {:local/root "../frontend"}
                   party.donut/hooked                  {:local/root "../hooked"}
                   party.donut/protocol-implementation {:local/root "../protocol-implementation"}
                   party.donut/sugar                   {:local/root "../sugar"}
                   party.donut/system                  {:local/root "../system"}}}

  :test-cljs
  {:extra-paths ["test"]
   :extra-deps  {org.clojure/test.check  {:mvn/version "0.9.0"}
                 olical/cljs-test-runner {:mvn/version "3.8.0"}}
   :exec-fn     cljs-test-runner.main/-main}

  :build
  {:deps       {io.github.clojure/tools.build {:mvn/version "0.9.6"}
                slipset/deps-deploy           {:mvn/version "0.2.1"}}
   :ns-default build}}}
